# 复制这个文件为 .env，填入你自己的配置

OPENAI_API_KEY=sk-你的key

# 接口地址。用 OpenAI 官方就保持默认；
# 换国内模型直接跑： python providers.py deepseek   （会改这两行）
OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的模型
OPENAI_MODEL=gpt-4o-mini

# 是否允许智能体执行 Python 代码（默认关闭，危险，按需开）
# ENABLE_CODE_EXEC=1

# 语音模型下载镜像（国内直连 HuggingFace 很慢）
HF_ENDPOINT=https://hf-mirror.com
